{
  "name": "fadeproof",
  "version": "1.0.0",
  "private": true,
  "description": "Fadeproof – studieplanner en game die je helpt herhalen net voordat je iets vergeet.",
  "scripts": {
    "start": "npx --yes serve www -l 8081",
    "build:native": "esbuild src/native.js --bundle --format=iife --minify --target=es2020 --outfile=www/vendor/native.js",
    "cap:sync": "npm run build:native && npx cap sync",
    "ios": "npx cap open ios",
    "ios:setup": "bash scripts/ios-setup.sh",
    "ios:update": "npm install && npm run build:native && npx cap sync ios && npm run ios:setup"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.4.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "esbuild": "^0.25.0"
  }
}
